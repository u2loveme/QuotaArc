<Window x:Class="QuotaArc.Desktop.CompactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuotaArc Mini" Width="220" Height="56" MinWidth="220" MinHeight="56"
        Icon="pack://application:,,,/QuotaArc;component/Assets/QuotaArc.ico"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource MiniSurfaceBrush}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="MiniSurfaceBrush" Color="#11161D" />
    <SolidColorBrush x:Key="MiniBorderBrush" Color="#39475A" />
    <LinearGradientBrush x:Key="MiniTrackBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#202A36" Offset="0" />
      <GradientStop Color="#18212B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MiniFiveHourBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#EFA65B" Offset="0" />
      <GradientStop Color="#E89A4A" Offset="0.52" />
      <GradientStop Color="#DC8D40" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MiniWeeklyBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#67C0E8" Offset="0" />
      <GradientStop Color="#55B6E7" Offset="0.52" />
      <GradientStop Color="#479FCE" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="MiniReserveBrush" Color="#807CA8" />
    <SolidColorBrush x:Key="MiniStatusBrush" Color="#D6B17C" />
    <SolidColorBrush x:Key="MiniTrackTopEdgeBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="MiniTrackBottomEdgeBrush" Color="#26000000" />
    <SolidColorBrush x:Key="MiniFillTopEdgeBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="MiniFillBottomEdgeBrush" Color="#24000000" />
    <SolidColorBrush x:Key="MiniFiveHourEndpointBrush" Color="#70FFD49B" />
    <SolidColorBrush x:Key="MiniWeeklyEndpointBrush" Color="#70B8E7FF" />
    <SolidColorBrush x:Key="MiniFiveHourGhostBrush" Color="#A5FFD49B" />
    <SolidColorBrush x:Key="MiniWeeklyGhostBrush" Color="#A5B8E7FF" />
    <LinearGradientBrush x:Key="MiniUpdateSweepBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#00FFFFFF" Offset="0" />
      <GradientStop Color="#26FFFFFF" Offset="0.5" />
      <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <CubicEase x:Key="MiniMotionEaseOut" EasingMode="EaseOut" />
    <DropShadowEffect x:Key="MiniValueShadow" Color="#11161D" BlurRadius="3" ShadowDepth="1" Opacity="0.9" />
    <DropShadowEffect x:Key="MiniActionShadow" Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.22" />

    <Style x:Key="MiniIconButton" TargetType="Button">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisualStyle}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource InteractionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource InteractionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MiniMainButton" TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
    </Style>
    <Style x:Key="MiniHideButton" TargetType="Button" BasedOn="{StaticResource MiniIconButton}">
      <Setter Property="FontFamily" Value="Segoe UI Semibold" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style x:Key="MiniActionRail" TargetType="Border">
      <Setter Property="Background" Value="#2411161D" />
      <Setter Property="BorderBrush" Value="#4039475A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="1" />
      <Setter Property="Effect" Value="{StaticResource MiniActionShadow}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="MiniPercentText" TargetType="TextBlock">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
      <Setter Property="Effect" Value="{StaticResource MiniValueShadow}" />
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="{DynamicResource MiniTrackBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track" ClipToBounds="True" SnapsToDevicePixels="True">
              <Border x:Name="TrackShape" Background="{TemplateBinding Background}" CornerRadius="0">
                <Grid IsHitTestVisible="False">
                  <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource MiniTrackTopEdgeBrush}" />
                  <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource MiniTrackBottomEdgeBrush}" />
                </Grid>
              </Border>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}" CornerRadius="0">
                <Grid ClipToBounds="True" IsHitTestVisible="False">
                  <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource MiniFillTopEdgeBrush}" />
                  <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource MiniFillBottomEdgeBrush}" />
                  <Border x:Name="FillEndpoint" Width="1" HorizontalAlignment="Right"
                          Background="{DynamicResource MiniWeeklyEndpointBrush}" />
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Tag" Value="Top">
                <Setter TargetName="TrackShape" Property="CornerRadius" Value="7,7,0,0" />
                <Setter TargetName="PART_Indicator" Property="CornerRadius" Value="7,0,0,0" />
                <Setter TargetName="FillEndpoint" Property="Background" Value="{DynamicResource MiniFiveHourEndpointBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Tag" Value="Top" />
                  <Condition Property="Value" Value="100" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Indicator" Property="CornerRadius" Value="7,7,0,0" />
              </MultiTrigger>
              <Trigger Property="Tag" Value="Bottom">
                <Setter TargetName="TrackShape" Property="CornerRadius" Value="0,0,7,7" />
                <Setter TargetName="PART_Indicator" Property="CornerRadius" Value="0,0,0,7" />
                <Setter TargetName="FillEndpoint" Property="Background" Value="{DynamicResource MiniReserveBrush}" />
                <Setter TargetName="FillEndpoint" Property="Opacity" Value="0.45" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Tag" Value="Bottom" />
                  <Condition Property="Value" Value="100" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Indicator" Property="CornerRadius" Value="0,0,7,7" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="MiniFrame" BorderBrush="{DynamicResource MiniBorderBrush}" BorderThickness="1"
          Background="{DynamicResource MiniSurfaceBrush}" CornerRadius="8" SnapsToDevicePixels="True">
    <Grid x:Name="PanelContent" ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="4*" />
        <RowDefinition Height="4*" />
        <RowDefinition Height="1*" />
      </Grid.RowDefinitions>
      <Grid x:Name="FiveHourRow" Grid.Row="0" ToolTipService.InitialShowDelay="350"
            AutomationProperties.Name="5-hour quota">
        <ProgressBar x:Name="FiveHourProgress" Tag="Top" Opacity="0.94"
                     Foreground="{DynamicResource MiniFiveHourBrush}" Background="{DynamicResource MiniTrackBrush}"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        <Border x:Name="FiveHourGhostMarker" Width="1" Height="10" Opacity="0"
                Background="{DynamicResource MiniFiveHourGhostBrush}" VerticalAlignment="Center"
                HorizontalAlignment="Left" IsHitTestVisible="False">
          <Border.RenderTransform>
            <TranslateTransform x:Name="FiveHourGhostTransform" />
          </Border.RenderTransform>
        </Border>
        <Border x:Name="FiveHourSweep" Width="28" Opacity="0" Background="{StaticResource MiniUpdateSweepBrush}"
                VerticalAlignment="Stretch" HorizontalAlignment="Left" IsHitTestVisible="False">
          <Border.RenderTransform>
            <TranslateTransform x:Name="FiveHourSweepTransform" />
          </Border.RenderTransform>
        </Border>
        <TextBlock x:Name="PreviousFiveHourValueText" Style="{StaticResource MiniPercentText}"
                   Visibility="Collapsed" />
        <TextBlock x:Name="FiveHourValueText" Text="—" IsHitTestVisible="False"
                   Style="{StaticResource MiniPercentText}" />
      </Grid>
      <Grid x:Name="WeeklyRow" Grid.Row="1" ToolTipService.InitialShowDelay="350"
            AutomationProperties.Name="Weekly quota">
        <ProgressBar x:Name="WeeklyProgress" Opacity="0.94"
                     Foreground="{DynamicResource MiniWeeklyBrush}" Background="{DynamicResource MiniTrackBrush}"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        <Border x:Name="WeeklyGhostMarker" Width="1" Height="10" Opacity="0"
                Background="{DynamicResource MiniWeeklyGhostBrush}" VerticalAlignment="Center"
                HorizontalAlignment="Left" IsHitTestVisible="False">
          <Border.RenderTransform>
            <TranslateTransform x:Name="WeeklyGhostTransform" />
          </Border.RenderTransform>
        </Border>
        <Border x:Name="WeeklySweep" Width="28" Opacity="0" Background="{StaticResource MiniUpdateSweepBrush}"
                VerticalAlignment="Stretch" HorizontalAlignment="Left" IsHitTestVisible="False">
          <Border.RenderTransform>
            <TranslateTransform x:Name="WeeklySweepTransform" />
          </Border.RenderTransform>
        </Border>
        <TextBlock x:Name="PreviousWeeklyValueText" Style="{StaticResource MiniPercentText}"
                   Visibility="Collapsed" />
        <TextBlock x:Name="WeeklyValueText" Text="—" IsHitTestVisible="False"
                   Style="{StaticResource MiniPercentText}" />
      </Grid>
      <Grid x:Name="ReserveRow" Grid.Row="2" ToolTipService.InitialShowDelay="350"
            AutomationProperties.Name="Reserve quota">
        <ProgressBar x:Name="ReserveProgress" Tag="Bottom" Opacity="0.88"
                     Foreground="{DynamicResource MiniReserveBrush}" Background="{DynamicResource MiniTrackBrush}"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
      </Grid>
      <Border x:Name="ActionRail" Style="{StaticResource MiniActionRail}"
              VerticalAlignment="Center" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <Button shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Style="{StaticResource MiniMainButton}" Background="Transparent" Margin="0,0,2,0"
                  ToolTip="Main window" AutomationProperties.Name="Show main window" Click="Main_Click">
            <Viewbox Width="12" Height="12" Stretch="Uniform">
              <Canvas Width="16" Height="16">
                <Path Data="M2,2.5 H14 V13.5 H2 Z M2,5.5 H14"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1.4" StrokeLineJoin="Round" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Style="{StaticResource MiniHideButton}" Background="Transparent"
                  ToolTip="Hide Mini" AutomationProperties.Name="Hide Mini panel" Click="Hide_Click">
            <Viewbox Width="12" Height="12" Stretch="Uniform">
              <Path Data="M1,6 L11,6"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Viewbox>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
