<Window x:Class="QuotaArc.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuotaArc"
        Icon="pack://application:,,,/QuotaArc;component/Assets/QuotaArc.ico"
        Width="1180" Height="800" MinWidth="960" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}"
        Loaded="Window_Loaded">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="SmallStatusTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="NotificationFeedButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="RowSurface" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="7"
                    Padding="10,8" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource InteractionBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsUnread}" Value="True">
                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsFocused}" Value="True">
                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource InteractionBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuotaLegendToggleStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="LegendChrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="LegendChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="LegendChrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="False">
                <Setter Property="Opacity" Value="0.48" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AppScrollPageButtonStyle" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AppScrollBarStyle" TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                              Style="{StaticResource AppScrollPageButtonStyle}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="24" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="ScrollThumb" Margin="1" CornerRadius="3"
                              Background="#526477" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ScrollThumb" Property="Background"
                                  Value="{DynamicResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="ScrollThumb" Property="Background"
                                  Value="{DynamicResource InteractionBrush}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                              Style="{StaticResource AppScrollPageButtonStyle}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SystemCaptionButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource CaptionButtonFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CaptionButtonChrome" Background="{TemplateBinding Background}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Tag" Value="Close" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </MultiTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="{DynamicResource PressedBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Tag" Value="Close" />
                  <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="CaptionButtonChrome" Property="Background" Value="#9E2116" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </MultiTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="CaptionButtonChrome" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionButtonFocusVisualStyle" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border Margin="4" BorderBrush="{DynamicResource TextSecondaryBrush}"
                    BorderThickness="1" IsHitTestVisible="False" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisualStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource ControlCornerRadius}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource HoverBrush}" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource InteractionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PressedBrush}" />
                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource InteractionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource HeaderBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            SizeChanged="HeaderBar_SizeChanged">
      <Grid>
       <Grid x:Name="HeaderLayout" Margin="22,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Image Width="20" Height="20" Margin="0,0,9,0" VerticalAlignment="Center"
                 Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                 Stretch="Uniform" />
          <TextBlock Text="QuotaArc" FontFamily="{StaticResource UiFontFamily}"
                     FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          <Border Width="1" Height="18" Margin="14,0" Background="{DynamicResource BorderBrush}" />
          <StackPanel x:Name="UpdatedAtStatus" Orientation="Horizontal"
                      VerticalAlignment="Center" AutomationProperties.Name="Dashboard update status">
            <Ellipse x:Name="UpdatedAtIndicator" Width="6" Height="6" Margin="0,0,7,0"
                     Fill="{DynamicResource UsageBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="UpdatedAtText" Text="Live · Updated just now"
                       Style="{StaticResource SmallStatusTextStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="210" />
          </StackPanel>
          <Button x:Name="RefreshButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Click="Refresh_Click" Width="34" Height="32" Padding="0" Margin="8,0,0,0"
                  Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                  BorderBrush="Transparent" ToolTip="Refresh data" AutomationProperties.Name="Refresh data"
                  FontFamily="Segoe UI Symbol" FontSize="17" Cursor="Hand">
            <Path x:Name="RefreshIcon" Width="20" Height="20" Stretch="Uniform"
                  Fill="{DynamicResource TextSecondaryBrush}"
                  Data="M17.65,6.35 C16.2,4.9 14.21,4 12,4 C7.58,4 4,7.58 4,12 C4,16.42 7.58,20 12,20 C15.73,20 18.84,17.45 19.73,14 L17.65,14 C16.83,16.33 14.61,18 12,18 C8.69,18 6,15.31 6,12 C6,8.69 8.69,6 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 L20,11 L20,4 Z"
                  RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
            </Path>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="40" Height="36" Margin="0,0,5,0">
            <Button x:Name="NotificationButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Padding="0" Margin="0" Width="36" Height="32"
                    Background="Transparent" BorderBrush="Transparent"
                    AutomationProperties.Name="Notifications"
                    ToolTip="Notifications" Click="NotificationButton_Click">
              <Path Width="17" Height="18" Stretch="Uniform"
                    Data="M10,2 C6.5,2 4,4.5 4,8 L4,11 C4,12.5 3,13.5 2,14 L18,14 C17,13.5 16,12.5 16,11 L16,8 C16,4.5 13.5,2 10,2 M8,16 C8.4,17.3 9,18 10,18 C11,18 11.6,17.3 12,16"
                    Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Button>
            <Border x:Name="NotificationBadge" HorizontalAlignment="Right" VerticalAlignment="Top"
                    MinWidth="8" Height="8" CornerRadius="5" Margin="0,1,1,0"
                    Background="{DynamicResource DangerBrush}" Visibility="Collapsed"
                    IsHitTestVisible="False">
              <TextBlock x:Name="NotificationBadgeText" FontFamily="{StaticResource UiFontFamily}"
                         FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                         Padding="3,0" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </Grid>
          <Button x:Name="ResetCompactPositionButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Width="36" Height="32" Padding="0" Margin="0,0,5,0"
                  Background="Transparent" BorderBrush="Transparent"
                  ToolTip="Restore Mini position and size"
                  AutomationProperties.Name="Restore Mini position and size"
                  Click="ResetCompactPosition_Click">
            <Path Width="17" Height="17" Stretch="Uniform" Fill="{x:Null}"
                  Data="M10,1 L10,6 M10,14 L10,19 M1,10 L6,10 M14,10 L19,10 M10,7 C8.35,7 7,8.35 7,10 C7,11.65 8.35,13 10,13 C11.65,13 13,11.65 13,10 C13,8.35 11.65,7 10,7 Z"
                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.45"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
          <Button x:Name="CompactButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Width="36" Height="32" Padding="0" Margin="0,0,5,0"
                  Background="Transparent" BorderBrush="Transparent"
                  ToolTip="Compact view" AutomationProperties.Name="Compact view"
                  Click="CompactView_Click">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{x:Null}"
                  Data="M3,3 L13,3 L13,13 L3,13 Z M7,7 L17,7 L17,17 L7,17 Z"
                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.4" />
          </Button>
          <Button x:Name="HideToTrayButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  Width="36" Height="32" Padding="0" Margin="0,0,0,0"
                  Background="Transparent" BorderBrush="Transparent"
                  ToolTip="Hide to tray" AutomationProperties.Name="Hide to tray"
                  Click="HideToTray_Click">
            <Path Width="16" Height="16" Stretch="Uniform" Fill="{x:Null}"
                  Data="M3,2 L17,2 L17,10 L3,10 Z M10,7 L10,18 M6,14 L10,18 L14,14"
                  Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
        </StackPanel>
       </Grid>
       <StackPanel x:Name="SystemCaptionButtons" Orientation="Horizontal"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch">
        <Button x:Name="MinimizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Style="{StaticResource SystemCaptionButtonStyle}" Height="48"
                ToolTip="Minimize" AutomationProperties.Name="Minimize"
                Click="Minimize_Click">
          <TextBlock Text="&#xE921;" />
        </Button>
        <Button x:Name="MaximizeRestoreButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Style="{StaticResource SystemCaptionButtonStyle}" Height="48"
                ToolTip="Maximize" AutomationProperties.Name="Maximize"
                Click="MaximizeRestore_Click">
          <TextBlock x:Name="MaximizeRestoreGlyph" Text="&#xE922;" />
        </Button>
        <Button x:Name="CloseButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                Style="{StaticResource SystemCaptionButtonStyle}" Tag="Close" Height="48"
                ToolTip="Close" AutomationProperties.Name="Close"
                Click="Close_Click">
          <TextBlock Text="&#xE8BB;" />
        </Button>
       </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer x:Name="DashboardScrollViewer" Grid.Row="1" Background="Transparent"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseLeftButtonDown="Background_PreviewMouseLeftButtonDown">
      <ScrollViewer.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}" />
      </ScrollViewer.Resources>
      <Grid Margin="22,0" MinHeight="{Binding ViewportHeight, ElementName=DashboardScrollViewer}">
        <Grid.RowDefinitions>
          <RowDefinition Height="152" />
          <RowDefinition Height="*" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="FiveHourCard" Grid.Column="0" Style="{StaticResource MetricCard}"
                Background="{StaticResource FiveHourCardBrush}" Margin="0,0,8,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="4" HorizontalAlignment="Left" Width="2" Margin="-18,0,0,0"
                    CornerRadius="1" Background="{DynamicResource FiveHourBrush}" IsHitTestVisible="False" />
            <TextBlock Text="5-HOUR LIMIT" Style="{StaticResource EyebrowText}" />
            <TextBlock x:Name="FiveHourValueText" Grid.Row="1" Text="—"
                       FontFamily="{StaticResource UiFontFamily}" FontSize="27" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,4" />
            <ProgressBar x:Name="FiveHourProgress" Grid.Row="2" Minimum="0" Maximum="100"
                         Height="7" Background="{DynamicResource SurfaceRaisedBrush}"
                         BorderThickness="0" Foreground="{DynamicResource FiveHourBrush}" />
            <TextBlock x:Name="FiveHourDetailText" Grid.Row="3" Text="Quota data unavailable"
                       Style="{StaticResource BodyText}" FontSize="11" Margin="0,5,0,0"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border x:Name="WeeklyCard" Grid.Column="1" Style="{StaticResource MetricCard}"
                Background="{StaticResource WeeklyCardBrush}" Margin="4,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="4" HorizontalAlignment="Left" Width="2" Margin="-18,0,0,0"
                    CornerRadius="1" Background="{DynamicResource WeeklyBrush}" IsHitTestVisible="False" />
            <TextBlock Text="WEEKLY LIMIT" Style="{StaticResource EyebrowText}" />
            <TextBlock x:Name="WeeklyValueText" Grid.Row="1" Text="—"
                       FontFamily="{StaticResource UiFontFamily}" FontSize="27" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,4" />
            <ProgressBar x:Name="WeeklyProgress" Grid.Row="2" Minimum="0" Maximum="100"
                         Height="7" Background="{DynamicResource SurfaceRaisedBrush}"
                         BorderThickness="0" Foreground="{DynamicResource WeeklyBrush}" />
            <TextBlock x:Name="WeeklyDetailText" Grid.Row="3" Text="Quota data unavailable"
                       Style="{StaticResource BodyText}" FontSize="11" Margin="0,5,0,0"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border x:Name="ReserveCard" Grid.Column="2" Style="{StaticResource MetricCard}"
                Background="{StaticResource ReserveCardBrush}" Margin="4,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="4" HorizontalAlignment="Left" Width="2" Margin="-18,0,0,0"
                    CornerRadius="1" Background="{DynamicResource InteractionBrush}" IsHitTestVisible="False" />
            <TextBlock Text="RESERVE LIMIT" Style="{StaticResource EyebrowText}" />
            <TextBlock x:Name="ReserveValueText" Grid.Row="1" Text="—"
                       FontFamily="{StaticResource UiFontFamily}" FontSize="27" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,4" />
            <ProgressBar x:Name="ReserveProgress" Grid.Row="2" Minimum="0" Maximum="100"
                         Height="7" Background="{DynamicResource SurfaceRaisedBrush}"
                         BorderThickness="0" Foreground="{DynamicResource InteractionBrush}" />
            <TextBlock x:Name="ReserveDetailText" Grid.Row="3" Text="Quota data unavailable"
                       Style="{StaticResource BodyText}" FontSize="11" Margin="0,5,0,0"
                       TextWrapping="Wrap" />
          </Grid>
        </Border>

        <Border x:Name="TodayCard" Grid.Column="3" Style="{StaticResource MetricCard}"
                Background="{StaticResource UsageCardBrush}" Margin="6,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="4" HorizontalAlignment="Left" Width="2" Margin="-18,0,0,0"
                    CornerRadius="1" Background="{DynamicResource UsageBrush}" IsHitTestVisible="False" />
            <TextBlock Text="TODAY · OBSERVED TOKENS" Style="{StaticResource EyebrowText}"
                       Foreground="{DynamicResource UsageBrush}" />
            <TextBlock x:Name="TodayValueText" Grid.Row="1" Text="—"
                       FontFamily="{StaticResource UiFontFamily}" FontSize="27" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,4"
                       SizeChanged="TodayValueText_SizeChanged" />
            <Canvas x:Name="TodaySparkline" Grid.Row="2" Height="18" Margin="0,0,0,1"
                    Background="Transparent" SizeChanged="TodaySparkline_SizeChanged" />
            <TextBlock x:Name="TodayDetailText" Grid.Row="3" Text="No local usage yet"
                       Style="{StaticResource BodyText}" FontSize="11" Margin="0,5,0,0"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>
      </Grid>

      <Border x:Name="QuotaHistoryCard" Grid.Row="1" Style="{StaticResource MetricCard}"
              Padding="{StaticResource ChartCardPadding}"
              Margin="0,14,0,10" MinHeight="215">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="1,0,1,5">
              <TextBlock x:Name="QuotaTitleText" Text="QUOTA TIMELINE · REMAINING %"
                         Style="{StaticResource EyebrowText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
              <StackPanel x:Name="QuotaRangePanel" Orientation="Horizontal"
                          HorizontalAlignment="Right">
                <Button Content="6H" Tag="quota:6" Click="HistoryRange_Click" />
                <Button Content="12H" Tag="quota:12" Click="HistoryRange_Click" />
                <Button Content="24H" Tag="quota:24" Click="HistoryRange_Click" />
                <Button Content="7D" Tag="quota:168" Click="HistoryRange_Click" />
                <Button Content="14D" Tag="quota:336" Click="HistoryRange_Click" />
                <Button Content="30D" Tag="quota:720" Click="HistoryRange_Click" />
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" MinHeight="145">
              <Canvas x:Name="QuotaChart" MinHeight="145"
                      Background="{DynamicResource PlotBrush}" SizeChanged="QuotaChart_SizeChanged"
                      MouseMove="QuotaChart_MouseMove" MouseLeave="QuotaChart_MouseLeave" />
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                          Margin="42,1,0,0">
                <ToggleButton x:Name="FiveHourLegendToggle" Tag="5-hour" IsChecked="True"
                              Style="{StaticResource QuotaLegendToggleStyle}"
                              ToolTip="Show or hide 5-hour quota history"
                              AutomationProperties.Name="Show 5-hour quota history"
                              Click="QuotaLegendToggle_Click">
                  <StackPanel Orientation="Horizontal">
                    <Rectangle Width="15" Height="2" Fill="{DynamicResource FiveHourBrush}"
                               VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock x:Name="FiveHourLegendText" Text="5-hour" FontFamily="{StaticResource UiFontFamily}" FontSize="9"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="WeeklyLegendToggle" Tag="weekly" IsChecked="True"
                              Style="{StaticResource QuotaLegendToggleStyle}"
                              ToolTip="Show or hide weekly quota history"
                              AutomationProperties.Name="Show weekly quota history"
                              Click="QuotaLegendToggle_Click">
                  <StackPanel Orientation="Horizontal">
                    <Rectangle Width="15" Height="2" Fill="{DynamicResource WeeklyBrush}"
                               VerticalAlignment="Center" Margin="0,0,5,0" />
                    <TextBlock x:Name="WeeklyLegendText" Text="Weekly" FontFamily="{StaticResource UiFontFamily}" FontSize="9"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </ToggleButton>
                <TextBlock x:Name="NoSampleLegendText" Text="– – no sample · dashed" FontFamily="{StaticResource UiFontFamily}"
                           FontSize="9" Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
              </StackPanel>
            </Grid>
          </Grid>
      </Border>

      <Border x:Name="DailyHistoryCard" Grid.Row="2" Style="{StaticResource MetricCard}"
              Padding="{StaticResource ChartCardPadding}"
              Margin="0,0,0,10" MinHeight="230">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="1,0,1,5">
              <TextBlock x:Name="DailyHistoryTitleText" Text="DAILY USAGE"
                         Style="{StaticResource EyebrowText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center" />
              <StackPanel x:Name="DailyRangePanel" Orientation="Horizontal"
                          HorizontalAlignment="Right">
                <Button Content="7D" Tag="daily:7" Click="HistoryRange_Click" />
                <Button Content="14D" Tag="daily:14" Click="HistoryRange_Click" />
                <Button Content="30D" Tag="daily:30" Click="HistoryRange_Click" />
                <Button Content="90D" Tag="daily:90" Click="HistoryRange_Click" />
              </StackPanel>
            </Grid>
            <Canvas x:Name="DailyChart" Grid.Row="1" MinHeight="120"
                    Background="{DynamicResource PlotBrush}" Cursor="Hand" SizeChanged="DailyChart_SizeChanged"
                    MouseLeftButtonDown="DailyChart_MouseLeftButtonDown"
                    MouseMove="DailyChart_MouseMove" MouseLeave="DailyChart_MouseLeave" />
            <Canvas x:Name="DailyHeatmap" Grid.Row="2" Height="32"
                    Background="Transparent" Cursor="Hand" Margin="0,3,0,0"
                    MouseLeftButtonDown="DailyHeatmap_MouseLeftButtonDown"
                    MouseMove="DailyHeatmap_MouseMove" MouseLeave="DailyChart_MouseLeave" />
            <TextBlock x:Name="DailyHistorySummaryText" Grid.Row="3"
                       Text="Loading local history…" Style="{StaticResource BodyText}"
                       FontSize="11" Margin="2,5,2,0"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
      </Border>

      <Grid Grid.Row="3" Margin="2,3,2,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="RefreshStatusText" Grid.Column="0"
                   Text="Opening local database read-only…"
                   Style="{StaticResource SmallStatusTextStyle}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <Button x:Name="SupportDevelopmentButton" Grid.Column="1"
                Height="18" MinHeight="18" Margin="14,0,1,0" Padding="0"
                Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextSecondaryBrush}"
                FontFamily="{StaticResource UiFontFamily}" FontWeight="Normal" FontSize="11"
                VerticalAlignment="Center"
                ToolTip="Support QuotaArc development"
                AutomationProperties.Name="Support QuotaArc development"
                AutomationProperties.HelpText="Opens the QuotaArc support page in your default browser."
                Click="SupportDevelopment_Click">
          <Button.Content>
            <StackPanel Height="18" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="♡" Foreground="{DynamicResource DangerBrush}"
                         FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="Support development" FontSize="11" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=IsMouseOver}"
                                   Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource FiveHourBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=IsKeyboardFocused}"
                                   Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource FiveHourBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Button.Content>
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="SupportEntryChrome" Background="Transparent" CornerRadius="3"
                      BorderBrush="Transparent" BorderThickness="1"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="SupportEntryChrome" Property="BorderBrush"
                          Value="{DynamicResource FiveHourBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
      </Grid>
      </Grid>
    </ScrollViewer>

    <Popup x:Name="NotificationPopup" Placement="Custom"
           StaysOpen="False" AllowsTransparency="True">
      <Border Width="390" MinWidth="320" MaxWidth="420" MaxHeight="500"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
              Padding="14" SnapsToDevicePixels="True">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="1,0,1,9">
            <Button Content="×" DockPanel.Dock="Right" Width="28" Height="27" Padding="0"
                    ToolTip="Close notifications" AutomationProperties.Name="Close notifications"
                    Click="NotificationPopup_CloseClick" />
            <StackPanel Margin="0,1,0,0">
              <TextBlock Text="Activity" FontFamily="{StaticResource UiFontFamily}"
                         FontSize="16" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
              <TextBlock x:Name="NotificationSummaryText" Text="Recent quota and data updates"
                         FontFamily="{StaticResource UiFontFamily}" FontSize="10"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>
          </DockPanel>
          <ScrollViewer x:Name="NotificationListScrollViewer" Grid.Row="1" MaxHeight="330"
                        VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
              <Style TargetType="ScrollBar"
                     BasedOn="{StaticResource AppScrollBarStyle}" />
            </ScrollViewer.Resources>
            <ItemsControl x:Name="NotificationItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource NotificationFeedButtonStyle}"
                          AutomationProperties.Name="{Binding AutomationLabel}"
                          ToolTip="Open related quota or usage view"
                          Click="NotificationItem_Click">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <DockPanel LastChildFill="True">
                          <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                   Fill="{Binding Accent}" />
                          <TextBlock Text="{Binding Category}" FontFamily="{StaticResource UiFontFamily}"
                                     FontSize="9" FontWeight="SemiBold" Foreground="{Binding Accent}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Message}" FontFamily="{StaticResource UiFontFamily}"
                                   FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding EventAt, StringFormat='{}{0:dd MMM · HH:mm} · Open details'}"
                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="9"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Border Background="{DynamicResource HoverBrush}" CornerRadius="7"
                                Padding="5,1" HorizontalAlignment="Right">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Visible" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Count}" Value="1">
                                  <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding Count}" FontFamily="{StaticResource UiFontFamily}"
                                     FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <Ellipse Width="6" Height="6" Margin="0,7,2,0"
                                 Fill="{DynamicResource InteractionBrush}" HorizontalAlignment="Right">
                          <Ellipse.Style>
                            <Style TargetType="Ellipse">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Ellipse.Style>
                        </Ellipse>
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,7,0,0">
            <StackPanel>
              <DockPanel LastChildFill="False">
                <Button x:Name="MarkAllReadButton" Content="Mark all read" Padding="8,5"
                        ToolTip="Mark all recent activity as read"
                        Click="MarkAllRead_Click" Visibility="Collapsed" />
                <Button x:Name="NotificationSettingsButton" Content="Settings" DockPanel.Dock="Right"
                        Padding="8,5" ToolTip="Show notification preferences"
                        Click="NotificationSettings_Click" />
              </DockPanel>
              <StackPanel x:Name="NotificationSettingsPanel" Visibility="Collapsed" Margin="0,9,0,0">
                <TextBlock Text="NOTIFICATION PREFERENCES" Style="{StaticResource EyebrowText}"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="2,0,0,6" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="132" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="2,2,8,5">
                    <TextBlock Text="Banner delivery" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                  <Button x:Name="NotificationDeliveryButton" Grid.Row="0" Grid.Column="1"
                          Content="Windows: Quiet" Width="132" Height="30" Padding="6,4"
                          Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}"
                          HorizontalContentAlignment="Center" Click="NotificationDelivery_Click" />
                  <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="2,2,8,5">
                    <TextBlock Text="Unread badge" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                  <Button x:Name="NotificationBadgeModeButton" Grid.Row="1" Grid.Column="1"
                          Content="Badge: Dot" Width="132" Height="30" Padding="6,4"
                          Margin="0,0,0,5" Foreground="{DynamicResource TextPrimaryBrush}"
                          HorizontalContentAlignment="Center" Click="NotificationBadgeMode_Click" />
                  <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="2,2,8,2">
                    <TextBlock Text="Alert sound" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                  </StackPanel>
                  <Button x:Name="NotificationSoundModeButton" Grid.Row="2" Grid.Column="1"
                          Content="Sound: Off" Width="132" Height="30" Padding="6,4" Margin="0"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          HorizontalContentAlignment="Center" Click="NotificationSoundMode_Click" />
                </Grid>
                <TextBlock Text="QUICK ACTIONS" Style="{StaticResource EyebrowText}"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,10,0,6" />
                <UniformGrid Columns="3">
                  <Button Content="Windows settings" Width="112" Height="28" Padding="4,4"
                          Margin="0" HorizontalAlignment="Center" FontSize="9"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          ToolTip="Open Windows notification settings"
                          AutomationProperties.Name="Open Windows notification settings"
                          Click="OpenWindowsNotificationSettings_Click" />
                  <Button x:Name="TestNotificationButton" Content="Test banner" Padding="4,4"
                          Width="112" Height="28" Margin="0" HorizontalAlignment="Center" FontSize="9"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          ToolTip="Send a test Windows notification"
                          Click="TestNotification_Click" />
                  <Button x:Name="TestNotificationSoundButton" Content="Test sound" Padding="4,4"
                          Width="112" Height="28" Margin="0" HorizontalAlignment="Center"
                          FontSize="9" Foreground="{DynamicResource TextPrimaryBrush}"
                          ToolTip="Play a test alert sound"
                          Click="TestNotificationSound_Click" />
                </UniformGrid>
                <TextBlock x:Name="NotificationPlatformStatusText" Text="Windows notifications are unavailable"
                           FontFamily="{StaticResource UiFontFamily}" FontSize="9"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,7,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock x:Name="NotificationEmptyText" Grid.Row="1" Text="All caught up · No recent activity"
                     FontFamily="{StaticResource UiFontFamily}" FontSize="12"
                     Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                     HorizontalAlignment="Center" Visibility="Collapsed" />
        </Grid>
      </Border>
    </Popup>

    <Border x:Name="SupportPromptPopup" Grid.RowSpan="2" Width="336" HorizontalAlignment="Right"
            VerticalAlignment="Top" Margin="0,56,16,0" Panel.ZIndex="20"
            Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9"
            Padding="13" SnapsToDevicePixels="True" Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <TranslateTransform x:Name="SupportPromptTranslate" Y="6" />
        </Border.RenderTransform>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="♡" FontSize="16" Margin="0,0,5,0"
                     Foreground="{DynamicResource FiveHourBrush}" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1">
            <TextBlock Text="Support QuotaArc" FontFamily="{StaticResource UiFontFamily}"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="QuotaArc is free to use. Optional support helps fund maintenance and future updates."
                       Margin="0,6,0,9" TextWrapping="Wrap" FontSize="10.5" LineHeight="15"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Content="Support development ↗" HorizontalAlignment="Left"
                    Padding="0" Margin="0" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource FiveHourBrush}" FontSize="10.5"
                    ToolTip="Open QuotaArc support in your default browser"
                    AutomationProperties.Name="Support development"
                    AutomationProperties.HelpText="Opens the QuotaArc support page and closes this message."
                    Click="SupportPromptCta_Click" />
          </StackPanel>
          <Button Grid.Column="2" Content="×" Width="24" Height="24" Padding="0"
                  Margin="5,0,0,0" VerticalAlignment="Top"
                  ToolTip="Close support message" AutomationProperties.Name="Close support message"
                  Click="SupportPromptClose_Click" />
        </Grid>
      </Border>
  </Grid>

</Window>
